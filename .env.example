# ══════════════════════════════════════════════════════════════════
#  Bharat Voter Portal — Environment Template
#  Copy this file to .env and fill in your actual keys.
#  The real .env is git-ignored and should NEVER be committed.
# ══════════════════════════════════════════════════════════════════

# ── Gemini REST API Key ───────────────────────────────────────────
# Free key from: https://aistudio.google.com/app/apikey
# Enables live Gemini 1.5 Flash AI chatbot.
# If blank → enhanced mock chatbot responses are used.
GEMINI_API_KEY=your_gemini_api_key_here

# ── Google Maps API Key ───────────────────────────────────────────
# Get at: https://console.cloud.google.com → Maps JavaScript API
# If blank → OpenStreetMap (Leaflet.js) is used as free fallback.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ── Google Cloud Platform (Optional) ─────────────────────────────
# Only needed for Document AI (Aadhaar OCR) and Vertex AI Search.
# The app works fully without these.
GCP_PROJECT_ID=your_gcp_project_id
GCP_REGION=us-central1
VERTEX_SEARCH_DATASTORE_ID=your_datastore_id
DOCAI_PROCESSOR_ID=your_processor_id

# ── Locale ────────────────────────────────────────────────────────
LANG=en_IN.UTF-8
